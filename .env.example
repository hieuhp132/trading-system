# API
NODE_ENV=development
PORT=4000
WEB_APP_URL=http://localhost:5173

# Database
DATABASE_URL="postgresql://gold_user:gold_password@localhost:5432/gold_trading?schema=public"
REDIS_URL="redis://localhost:6379"

# JWT
JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-secret"

JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Market data provider
MARKET_DATA_PROVIDER=
MARKET_DATA_API_KEY=

# Maximum chart history returned per interval (clamped to stored history).
MARKET_CANDLES_LIMIT_1M=5000
MARKET_CANDLES_LIMIT_5M=5000
MARKET_CANDLES_LIMIT_15M=5000
MARKET_CANDLES_LIMIT_1H=5000
MARKET_CANDLES_LIMIT_4H=2000
MARKET_CANDLES_LIMIT_1D=1000

# Upstream quote polling cache; default matches a 1-credit-per-minute plan.
# TWELVE_DATA_PRICE_CACHE_TTL_MS=60000

# Paper execution may reuse the last live quote this long (ms). Default 60000.
# TRADING_QUOTE_MAX_AGE_MS=60000
