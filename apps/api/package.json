{
  "name": "@gold/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "prisma:contract": "prisma contract emit",
    "prisma:migration:plan": "prisma migration plan",
    "prisma:migration:check": "prisma migration check",
    "prisma:db:migrate": "prisma db migrate",
    "prisma:db:verify": "prisma db verify",
    "contract:emit": "prisma contract emit",
    "test:e2e": "powershell.exe -NoProfile -File ./src/run-regression-e2e.ps1",
    "verify": "pnpm run typecheck && pnpm run build && pnpm run test:e2e"
  },
  "dependencies": {
    "@prisma/orm-postgres": "8.0.0-rc.11",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^9.17.0",
    "prisma": "8.0.0-rc.15",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
